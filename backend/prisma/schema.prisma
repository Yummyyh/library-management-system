// 数据源和生成器设置
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ⚠️ 注意：SQLite 对 Enum 支持有限，改用 String + 注释方式
// 原 Enum 定义已移除，取值通过应用层校验

// ========== 用户表：保存用户信息 ==========
model User {
  /// 主键
  id           String    @id @default(cuid())
  /// 用户名
  name         String
  /// 邮箱，唯一
  email        String    @unique
  /// 密码哈希
  passwordHash String
  /// 学号，唯一
  studentId    String    @unique
  /// 角色：取值 "STUDENT" | "LIBRARIAN" | "ADMIN"
  role         String
  /// 状态：取值 "ACTIVE" | "DEACTIVATED"
  status       String    @default("ACTIVE")
  /// 创建时间
  createdAt    DateTime  @default(now())
  /// 更新时间
  updatedAt    DateTime  @updatedAt

  // 关系
  /// 该用户的借阅记录
  loans        Loan[]
  /// 该用户的评分记录
  ratings      Rating[]
  /// 该用户的预约记录
  holds        Hold[]
  /// 该用户的心愿单
  wishlists    Wishlist[]
  /// 该用户的操作日志
  auditLogs     AuditLog[]
  notifications Notification[]
}

// ========== 图书表（书目层：ISBN维度） ==========
model Book {
  /// 主键
  id            String    @id @default(cuid())
  /// 标题
  title         String
  /// 作者
  author        String
  /// ISBN，唯一（代表图书类型，同一ISBN可对应多本实体册）
  isbn          String    @unique
  /// 类型/类别
  genre         String
  /// 描述
  description   String
  /// 语言
  language      String
  /// 书架位置
  shelfLocation String
  /// 分类（可选）
  category      String?
  /// 出版社（可选，用于详情页）
  publisher     String?
  /// 出版日期（可选）
  publishedAt   DateTime?
  /// 是否删除（软删除标记）
  isDeleted     Boolean   @default(false)
  /// 创建时间
  createdAt     DateTime  @default(now())
  /// 更新时间
  updatedAt     DateTime  @updatedAt

  // 关系
  /// 该书对应的所有实体册（条形码记录）
  barcodes      Barcode[]
  /// 该书收到的所有评分
  ratings       Rating[]
  /// 该书的所有预约请求
  holds         Hold[]
  /// 该书的所有心愿单记录
  wishlists     Wishlist[]
}

// ========== 条形码表（实体层：物理册维度） ==========
model Barcode {
  /// 主键
  id          String    @id @default(cuid())
  /// 条形码编号，唯一（格式：ISBN-001 / ISBN-002 ...）
  barcode     String    @unique
  /// 关联书目ID
  bookId      String
  /// 状态：取值 "AVAILABLE" | "BORROWED" | "LOST" | "DAMAGED"
  status      String    @default("AVAILABLE")
  /// 创建时间
  createdAt   DateTime  @default(now())

  // 关系
  /// 所属书目
  book        Book      @relation(fields: [bookId], references: [id])
  /// 当前借阅记录（若存在）
  loans       Loan[]
}

// ========== 借阅记录表（业务层） ==========
model Loan {
  /// 主键
  id           String    @id @default(cuid())
  /// 关联条形码ID（精准定位具体册数）
  barcodeId    String
  /// 关联用户ID
  userId       String
  /// 借出日期
  checkoutDate DateTime
  /// 到期日期
  dueDate      DateTime
  /// 归还日期，允许为空
  returnDate   DateTime?
  /// 罚金金额
  fineAmount   Float     @default(0)
  /// 罚金已支付
  finePaid     Boolean   @default(false)
  /// 罚金已豁免
  fineForgiven Boolean   @default(false)
  /// 创建时间
  createdAt    DateTime  @default(now())

  // 关系
  /// 关联的具体实体册
  barcode      Barcode   @relation(fields: [barcodeId], references: [id])
  /// 借阅用户
  user         User      @relation(fields: [userId], references: [id])
}

// ========== 评分表：用户对图书的评分 ==========
model Rating {
  /// 主键
  id        String   @id @default(cuid())
  /// 关联图书ID（评分针对书目，非具体册）
  bookId    String
  /// 关联用户ID
  userId    String
  /// 评分（1-5星）
  stars     Int
  /// 创建时间
  createdAt DateTime @default(now())

  // 关系
  /// 被评分的图书
  book      Book     @relation(fields: [bookId], references: [id])
  /// 评分用户
  user      User     @relation(fields: [userId], references: [id])

  /// 同一用户对同一本书只能评分一次
  @@unique([bookId, userId])
}

// ========== 预约表：用于排队借阅未上架图书 ==========
model Hold {
  /// 主键
  id        String   @id @default(cuid())
  /// 关联图书ID（预约针对书目，非具体册）
  bookId    String
  /// 关联用户ID
  userId    String
  /// 状态：取值 "WAITING" | "READY" | "CANCELLED"
  status    String
  /// 创建时间
  createdAt DateTime @default(now())

  // 关系
  /// 被预约的图书
  book      Book     @relation(fields: [bookId], references: [id])
  /// 预约用户
  user      User     @relation(fields: [userId], references: [id])
}

// ========== 心愿单表：用户希望借阅的图书 ==========
model Wishlist {
  /// 主键
  id        String   @id @default(cuid())
  /// 关联图书ID
  bookId    String
  /// 关联用户ID
  userId    String
  /// 创建时间
  createdAt DateTime @default(now())

  // 关系
  /// 心愿图书
  book      Book     @relation(fields: [bookId], references: [id])
  /// 添加用户
  user      User     @relation(fields: [userId], references: [id])
}

// ========== 配置表：存放全局配置项（如系统参数） ==========
model Config {
  /// 主键
  id     String @id @default(cuid())
  /// 键，唯一（如："FINE_RATE_PER_DAY", "LOAN_PERIOD_DAYS"）
  key    String @unique
  /// 值
  value  String
}

// ========== 通知表：系统通知与管理员消息 ==========
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   // "HOLD_READY" | "HOLD_CANCELLED" | "OVERDUE" | "GENERAL"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

// ========== 审计日志表：记录操作日志 ==========
model AuditLog {
  /// 主键
  id        String   @id @default(cuid())
  /// 操作用户ID，可为空
  userId    String?
  /// 操作动作（如："BOOK_CREATED", "LOAN_CHECKOUT"）
  action    String
  /// 操作实体（如："Book", "Loan"）
  entity    String
  /// 实体ID
  entityId  String
  /// 详细内容
  detail    String
  /// 创建时间
  createdAt DateTime @default(now())

  // 关系
  /// 操作用户（可选）
  user      User?    @relation(fields: [userId], references: [id])
}